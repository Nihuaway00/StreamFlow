# Пример конфигурации для StreamFlow
# Из этого можно создать конфигурацию для локального запуска

# ============================================
# DATABASE
# ============================================
# Для Docker: postgres (имя сервиса из docker-compose)
# Для локальной разработки: localhost
DATABASE_URL=postgresql://user:password@postgres:5432/streaming_db


# MINIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESSKEY=test
MINIO_SECRETKEY=secure123$
MINIO_BUCKET=dev

# ============================================
# JWT & SECURITY
# ============================================
# ВАЖНО: Сгенерируйте свой уникальный ключ! Однако для локальной разработки можно любое значение
# Способы генерации:
#   - openssl rand -hex 32
#   - python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# MEDIA SERVER
# ============================================
# Для Docker: media-server (имя сервиса)
# Для локальной разработки: localhost
RTMP_SERVER_HOST=media-server
RTMP_PORT=1935
HLS_BASE_URL=http://localhost:8080

# ============================================
# API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000